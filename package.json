{
  "name": "pod_browser",
  "version": "0.4.24",
  "license": "Apache-2.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^0.2.3",
    "@hoelk-f/semantic-data-catalog": "0.8.94",
    "@hoelk-f/solid-data-manager": "0.4.32",
    "@hoelk-f/solid-health-app": "0.1.28",
    "@hoelk-f/solid-health-questionnaire": "0.1.10",
    "@hoelk-f/city-tours": "0.1.35",
    "@inrupt/solid-client": "^2.1.2",
    "@inrupt/solid-client-authn-browser": "5.0.3",
    "@inrupt/vocab-common-rdf": "^1.0.5",
    "@mui/material": "^7.3.7",
    "@mui/x-data-grid": "^8.24.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.7.7",
    "n3": "^1.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-force-graph-2d": "^1.25.6",
    "react-router-dom": "^7.8.0",
    "react-scripts": "5.0.1",
    "three": "^0.184.0",
    "uuid": "^11.1.0",
    "vis-network": "^9.1.9",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "prestart": "node scripts/build-legal-pages.cjs && node scripts/write-runtime-config.js",
    "prebuild": "node scripts/build-legal-pages.cjs && node scripts/write-runtime-config.js",
    "start": "react-scripts start",
    "start:local-packages": "node scripts/start-local-package-watch.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "build:legal": "node scripts/build-legal-pages.cjs",
    "check:production-routes": "node scripts/check-production-routes.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "overrides": [
      {
        "files": [
          "**/__tests__/**/*",
          "**/*.{spec,test}.*"
        ],
        "env": {
          "jest": true
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "overrides": {
    "@inrupt/solid-client-authn-browser": "$@inrupt/solid-client-authn-browser",
    "@inrupt/solid-client-authn-core": "5.0.3",
    "@inrupt/oidc-client-ext": "5.0.3"
  },
  "jest": {
    "transformIgnorePatterns": [
      "/node_modules/(?!(@inrupt/|jose/|uuid/))",
      "^.+\\.module\\.(css|sass|scss)$"
    ]
  }
}
